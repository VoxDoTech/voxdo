# GigaAM Service Configuration

# Server
HOST=0.0.0.0
PORT=7860

# Model
MODEL_NAME=v3_e2e_rnnt

# HuggingFace Token (для pyannote моделей, longform-диаризации)
HF_TOKEN=

# Audio Preprocessing
AUTO_RESAMPLE_ENABLED=true
TARGET_SAMPLE_RATE=16000

# File limits
# MAX_FILE_SIZE=104857600        # байты, по умолчанию 100MB
# TRANSCRIPTION_TIMEOUT=900      # секунды
# MODEL_WORKERS=2
# MODEL_LOADING_TIMEOUT=1800

# Cache
# CACHE_MAX_SIZE=1000
# CACHE_MAX_AGE_HOURS=24

# Dual ASR + LLM Correction (оркестрация через Inngest)
ENABLE_DUAL_ASR_LLM_CORRECTION=true

# Inngest Connection (для асинхронной транскрипции)
# Если настроено, giga-am будет отправлять события о завершении в Inngest
INNGEST_API_URL=http://localhost:3001
INNGEST_EVENT_KEY=  # Опционально, для отправки callback событий

# Logging
LOG_LEVEL=INFO
