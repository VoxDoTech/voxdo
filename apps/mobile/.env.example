# Base URL of the apps/app Next.js server.
# - Android emulator:  http://10.0.2.2:3000
# - Physical device:   http://<dev-machine-LAN-IP>:3000
# - Production build:  https://your-domain.com
VITE_API_URL=http://10.0.2.2:3000

# Local dev only: allows cleartext HTTP in the Android WebView so the app
# can reach the dev server. Never set this for release builds.
# CAPACITOR_CLEAR_TEXT=1
